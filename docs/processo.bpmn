<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="definicoes_triagem" targetNamespace="https://github.com/leooruiz/zelacidade-rpa" exporter="gerado à mão para o ZelaCidade" exporterVersion="1.0">
<bpmn:process id="processo" name="Triagem ZelaCidade" isExecutable="false"><bpmn:startEvent id="inicio" name="A cada 30 minutos (Agendador do Windows)"><bpmn:outgoing>f_inicio_ler_config</bpmn:outgoing><bpmn:timerEventDefinition id="timer_30min"><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30M</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:startEvent><bpmn:task id="ler_config" name="Ler .env e regras.json"><bpmn:incoming>f_inicio_ler_config</bpmn:incoming><bpmn:outgoing>f_ler_config_gw_config</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_config" name="Configuração válida?"><bpmn:incoming>f_ler_config_gw_config</bpmn:incoming><bpmn:outgoing>f_gw_config_buscar</bpmn:outgoing><bpmn:outgoing>f_gw_config_erro_config</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="erro_config" name="Registrar ERRO e avisar o responsável por e-mail"><bpmn:incoming>f_gw_config_erro_config</bpmn:incoming><bpmn:outgoing>f_erro_config_fim_config</bpmn:outgoing></bpmn:task><bpmn:endEvent id="fim_config" name="Encerra (código 2)"><bpmn:incoming>f_erro_config_fim_config</bpmn:incoming></bpmn:endEvent><bpmn:task id="buscar" name="Buscar área piloto, recebidas e abertas (até 4 tentativas: 5, 15 e 45 s)"><bpmn:incoming>f_gw_config_buscar</bpmn:incoming><bpmn:outgoing>f_buscar_gw_api</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_api" name="API respondeu?"><bpmn:incoming>f_buscar_gw_api</bpmn:incoming><bpmn:outgoing>f_gw_api_chuva</bpmn:outgoing><bpmn:outgoing>f_gw_api_erro_api</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="erro_api" name="Registrar ERRO e e-mail &quot;API indisponível&quot;"><bpmn:incoming>f_gw_api_erro_api</bpmn:incoming><bpmn:outgoing>f_erro_api_fim_api</bpmn:outgoing></bpmn:task><bpmn:endEvent id="fim_api" name="Encerra (código 3)"><bpmn:incoming>f_erro_api_fim_api</bpmn:incoming></bpmn:endEvent><bpmn:task id="chuva" name="Consultar chuva prevista para 24 h (Open-Meteo)"><bpmn:incoming>f_gw_api_chuva</bpmn:incoming><bpmn:outgoing>f_chuva_lote</bpmn:outgoing></bpmn:task><bpmn:subProcess id="lote" name="Para cada ocorrência recebida (lote, uma por vez)"><bpmn:incoming>f_chuva_lote</bpmn:incoming><bpmn:outgoing>f_lote_procurar</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true" /><bpmn:startEvent id="ini_item"><bpmn:outgoing>f_ini_item_validar</bpmn:outgoing></bpmn:startEvent><bpmn:task id="validar" name="Validar campos e, se for de cidadão, se está na área piloto"><bpmn:incoming>f_ini_item_validar</bpmn:incoming><bpmn:outgoing>f_validar_gw_valida</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_valida" name="Válida?"><bpmn:incoming>f_validar_gw_valida</bpmn:incoming><bpmn:outgoing>f_gw_valida_gw_dup</bpmn:outgoing><bpmn:outgoing>f_gw_valida_precisa_info</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="precisa_info" name="Marcar &quot;precisa de informação&quot; com o motivo"><bpmn:incoming>f_gw_valida_precisa_info</bpmn:incoming><bpmn:outgoing>f_precisa_info_gw_junta</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_dup" name="Duplicada? (mesma categoria, até 30 m, até 14 dias)"><bpmn:incoming>f_gw_valida_gw_dup</bpmn:incoming><bpmn:outgoing>f_gw_dup_duplicada</bpmn:outgoing><bpmn:outgoing>f_gw_dup_pontuar</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="duplicada" name="Marcar duplicada (+1 confirmação na original)"><bpmn:incoming>f_gw_dup_duplicada</bpmn:incoming><bpmn:outgoing>f_duplicada_gw_junta</bpmn:outgoing></bpmn:task><bpmn:task id="pontuar" name="Calcular prioridade por pontos e escrever o motivo"><bpmn:incoming>f_gw_dup_pontuar</bpmn:incoming><bpmn:outgoing>f_pontuar_gw_junta</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_junta"><bpmn:incoming>f_pontuar_gw_junta</bpmn:incoming><bpmn:incoming>f_duplicada_gw_junta</bpmn:incoming><bpmn:incoming>f_precisa_info_gw_junta</bpmn:incoming><bpmn:outgoing>f_gw_junta_patch</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="patch" name="Enviar triagem ao MVP (falha no item: registra e segue)"><bpmn:incoming>f_gw_junta_patch</bpmn:incoming><bpmn:outgoing>f_patch_avisar</bpmn:outgoing></bpmn:task><bpmn:task id="avisar" name="E-mail ao gestor se alta e ao morador se consentiu"><bpmn:incoming>f_patch_avisar</bpmn:incoming><bpmn:outgoing>f_avisar_fim_item</bpmn:outgoing></bpmn:task><bpmn:endEvent id="fim_item"><bpmn:incoming>f_avisar_fim_item</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f_ini_item_validar" sourceRef="ini_item" targetRef="validar" /><bpmn:sequenceFlow id="f_validar_gw_valida" sourceRef="validar" targetRef="gw_valida" /><bpmn:sequenceFlow id="f_gw_valida_gw_dup" name="Sim" sourceRef="gw_valida" targetRef="gw_dup" /><bpmn:sequenceFlow id="f_gw_valida_precisa_info" name="Não" sourceRef="gw_valida" targetRef="precisa_info" /><bpmn:sequenceFlow id="f_gw_dup_duplicada" name="Sim" sourceRef="gw_dup" targetRef="duplicada" /><bpmn:sequenceFlow id="f_gw_dup_pontuar" name="Não" sourceRef="gw_dup" targetRef="pontuar" /><bpmn:sequenceFlow id="f_pontuar_gw_junta" sourceRef="pontuar" targetRef="gw_junta" /><bpmn:sequenceFlow id="f_duplicada_gw_junta" sourceRef="duplicada" targetRef="gw_junta" /><bpmn:sequenceFlow id="f_precisa_info_gw_junta" sourceRef="precisa_info" targetRef="gw_junta" /><bpmn:sequenceFlow id="f_gw_junta_patch" sourceRef="gw_junta" targetRef="patch" /><bpmn:sequenceFlow id="f_patch_avisar" sourceRef="patch" targetRef="avisar" /><bpmn:sequenceFlow id="f_avisar_fim_item" sourceRef="avisar" targetRef="fim_item" /></bpmn:subProcess><bpmn:task id="procurar" name="Procurar o ouro_painel_*.json mais recente em entrada/ouro"><bpmn:incoming>f_lote_procurar</bpmn:incoming><bpmn:outgoing>f_procurar_gw_painel</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_painel" name="Arquivo do painel?"><bpmn:incoming>f_procurar_gw_painel</bpmn:incoming><bpmn:outgoing>f_gw_painel_publicar</bpmn:outgoing><bpmn:outgoing>f_gw_painel_rejeitar</bpmn:outgoing><bpmn:outgoing>f_gw_painel_gw_fim</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="rejeitar" name="Mover para rejeitados/ e avisar o responsável"><bpmn:incoming>f_gw_painel_rejeitar</bpmn:incoming><bpmn:outgoing>f_rejeitar_gw_fim</bpmn:outgoing></bpmn:task><bpmn:task id="publicar" name="Publicar indicadores no MVP"><bpmn:incoming>f_gw_painel_publicar</bpmn:incoming><bpmn:outgoing>f_publicar_gw_fim</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="gw_fim"><bpmn:incoming>f_gw_painel_gw_fim</bpmn:incoming><bpmn:incoming>f_publicar_gw_fim</bpmn:incoming><bpmn:incoming>f_rejeitar_gw_fim</bpmn:incoming><bpmn:outgoing>f_gw_fim_fechar</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="fechar" name="Gravar log JSONL e relatório CSV; e-mail de resumo"><bpmn:incoming>f_gw_fim_fechar</bpmn:incoming><bpmn:outgoing>f_fechar_fim</bpmn:outgoing></bpmn:task><bpmn:endEvent id="fim" name="Fim (código 0, ou 1 se houve falha em item)"><bpmn:incoming>f_fechar_fim</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="f_inicio_ler_config" sourceRef="inicio" targetRef="ler_config" /><bpmn:sequenceFlow id="f_ler_config_gw_config" sourceRef="ler_config" targetRef="gw_config" /><bpmn:sequenceFlow id="f_gw_config_buscar" name="Sim" sourceRef="gw_config" targetRef="buscar" /><bpmn:sequenceFlow id="f_gw_config_erro_config" name="Não" sourceRef="gw_config" targetRef="erro_config" /><bpmn:sequenceFlow id="f_erro_config_fim_config" sourceRef="erro_config" targetRef="fim_config" /><bpmn:sequenceFlow id="f_buscar_gw_api" sourceRef="buscar" targetRef="gw_api" /><bpmn:sequenceFlow id="f_gw_api_chuva" name="Sim" sourceRef="gw_api" targetRef="chuva" /><bpmn:sequenceFlow id="f_gw_api_erro_api" name="Não" sourceRef="gw_api" targetRef="erro_api" /><bpmn:sequenceFlow id="f_erro_api_fim_api" sourceRef="erro_api" targetRef="fim_api" /><bpmn:sequenceFlow id="f_chuva_lote" sourceRef="chuva" targetRef="lote" /><bpmn:sequenceFlow id="f_lote_procurar" sourceRef="lote" targetRef="procurar" /><bpmn:sequenceFlow id="f_procurar_gw_painel" sourceRef="procurar" targetRef="gw_painel" /><bpmn:sequenceFlow id="f_gw_painel_publicar" name="Válido" sourceRef="gw_painel" targetRef="publicar" /><bpmn:sequenceFlow id="f_gw_painel_rejeitar" name="Inválido" sourceRef="gw_painel" targetRef="rejeitar" /><bpmn:sequenceFlow id="f_gw_painel_gw_fim" name="Ausente: mantém o painel atual" sourceRef="gw_painel" targetRef="gw_fim" /><bpmn:sequenceFlow id="f_publicar_gw_fim" sourceRef="publicar" targetRef="gw_fim" /><bpmn:sequenceFlow id="f_rejeitar_gw_fim" sourceRef="rejeitar" targetRef="gw_fim" /><bpmn:sequenceFlow id="f_gw_fim_fechar" sourceRef="gw_fim" targetRef="fechar" /><bpmn:sequenceFlow id="f_fechar_fim" sourceRef="fechar" targetRef="fim" /></bpmn:process>
